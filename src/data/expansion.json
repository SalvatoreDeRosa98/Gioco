        {
          "who": "ratking",
          "text": "Mi cacciarono qui sotto. I ratti mi divisero il pane. Sono cresciuto con loro."
        },
        {
          "who": "ratking",
          "text": "Guarda cosa sono diventato. Mezzo ragazzo, mezzo ratto. Questa è casa nostra. Non ce la prenderai."
        }
      ]
    },
    "outro": {
      "id": "ratking_outro",
      "lines": [
        {
          "text": "Ratking arretra nell’ombra. I ratti lo circondano e lo accompagnano al riparo."
        },
