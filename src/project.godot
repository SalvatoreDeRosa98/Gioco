; Engine configuration file.
; Godot 4.6 (versione fissata in docs/engine-reference/godot/VERSION.md).

config_version=5

[application]

config/name="Ferruccio - La Menzogna dei Borbone"
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Tuning="*res://autoload/tuning.gd"
Audio="*res://autoload/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[importer_defaults]

texture={
"mipmaps/generate": true
}
